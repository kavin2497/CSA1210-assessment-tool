def generate_report():

    report = []

    report.append(
        "AI WORKLOAD PERFORMANCE ANALYZER"
    )

    report.append(
        "=" * 50
    )

    report.append(
        f"Job ID: {job.job_id}"
    )

    report.append(
        f"Images: {job.num_images}"
    )

    report.append(
        f"Image Size: {job.image_size_mb} MB"
    )

    report.append(
        f"Total Data: {total_data} MB"
    )

    report.append("")

    report.append(
        "PIPELINE PERFORMANCE"
    )

    report.append("-" * 30)

    report.append(
        f"Instructions: "
        f"{pipeline_metrics['instructions']}"
    )

    report.append(
        f"Ideal Cycles: "
        f"{pipeline_metrics['ideal_cycles']}"
    )

    report.append(
        f"Stalls: "
        f"{pipeline_metrics['stalls']}"
    )

    report.append(
        f"Flushes: "
        f"{pipeline_metrics['flushes']}"
    )

    report.append(
        f"Total Cycles: "
        f"{pipeline_metrics['total_cycles']}"
    )

    report.append(
        f"CPI: "
        f"{pipeline_metrics['cpi']:.2f}"
    )

    report.append(
        f"Execution Time: "
        f"{pipeline_metrics['execution_time_ns']:.2f} ns"
    )

    report.append(
        f"Speed-up: "
        f"{pipeline_metrics['speedup']:.2f}x"
    )

    report.append("")

    report.append(
        "CACHE PERFORMANCE"
    )

    report.append("-" * 30)

    for item in cache_result["statistics"]:

        report.append(
            f"{item['Level']}: "
            f"Hits={item['Hits']}, "
            f"Misses={item['Misses']}, "
            f"Hit Ratio={item['Hit Ratio']:.2%}"
        )

    report.append(
        f"AMAT: {cache_result['amat']:.2f} ns"
    )

    report.append("")

    report.append(
        "I/O PERFORMANCE"
    )

    report.append("-" * 30)

    for item in io_results:

        report.append(
            f"{item['Method']}: "
            f"Transfer Time={item['Transfer Time (s)']:.4f}s, "
            f"CPU Utilization="
            f"{item['CPU Utilization (%)']:.2f}%, "
            f"CPU Interventions="
            f"{item['CPU Interventions']}"
        )

    report.append("")

    report.append(
        "BOTTLENECK ANALYSIS"
    )

    report.append("-" * 30)

    for name, score in scores.items():

        report.append(
            f"{name}: {score:.2f}"
        )

    report.append(
        f"Major Bottleneck: {bottleneck}"
    )

    return "\n".join(report)


