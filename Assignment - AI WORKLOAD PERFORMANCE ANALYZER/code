# ==============================================================
# PIPELINE ANALYZER
# ==============================================================

class PipelineAnalyzer:

    STAGES = ["IF", "ID", "EX", "MEM", "WB"]

    def __init__(self, instructions, clock_time_ns=1):
        self.instructions = instructions
        self.clock_time_ns = clock_time_ns

    def analyze_hazards(self):

        hazards = []
        stalls = 0
        flushes = 0

        for i, current in enumerate(self.instructions):

            # -------------------------------
            # DATA HAZARD - RAW
            # -------------------------------

            for previous in self.instructions[:i]:

                if previous.dest and previous.dest in current.src:

                    hazards.append({
                        "Instruction": current.iid,
                        "Type": "Data / RAW",
                        "Reason": (
                            f"Reads {previous.dest} "
                            f"written by {previous.iid}"
                        ),
                        "Penalty": "1 stall"
                    })

                    stalls += 1

            # -------------------------------
            # CONTROL HAZARD
            # -------------------------------

            if current.operation.upper() == "BRANCH":

                hazards.append({
                    "Instruction": current.iid,
                    "Type": "Control",
                    "Reason": "Branch changes possible next PC",
                    "Penalty": "2 flush cycles"
                })

                flushes += 2

            # -------------------------------
            # STRUCTURAL HAZARD
            # -------------------------------

            if i > 0:

                previous = self.instructions[i - 1]

                if (
                    current.resource == previous.resource
                    and current.resource in ["MEMORY", "MULTIPLIER"]
                ):

                    hazards.append({
                        "Instruction": current.iid,
                        "Type": "Structural",
                        "Reason": (
                            f"Consecutive use of "
                            f"{current.resource} resource"
                        ),
                        "Penalty": "1 stall"
                    })

                    stalls += 1

        return hazards, stalls, flushes

    def pipeline_table(self):

        rows = []

        for index, instruction in enumerate(self.instructions):

            start_cycle = index + 1

            row = {
                "Instruction": instruction.iid,
                "Operation": instruction.operation
            }

            for stage_index, stage in enumerate(self.STAGES):

                row[stage] = start_cycle + stage_index

            rows.append(row)

        return pd.DataFrame(rows)

    def metrics(self):

        n = len(self.instructions)

        hazards, stalls, flushes = self.analyze_hazards()

        ideal_cycles = n + 4

        total_cycles = ideal_cycles + stalls + flushes

        cpi = total_cycles / n if n else 0

        execution_time = total_cycles * self.clock_time_ns

        non_pipeline_cycles = n * 5

        speedup = (
            non_pipeline_cycles / total_cycles
            if total_cycles else 0
        )

        return {
            "instructions": n,
            "ideal_cycles": ideal_cycles,
            "stalls": stalls,
            "flushes": flushes,
            "total_cycles": total_cycles,
            "cpi": cpi,
            "execution_time_ns": execution_time,
            "non_pipeline_cycles": non_pipeline_cycles,
            "speedup": speedup,
            "hazards": hazards
        }


# ==============================================================
# CACHE LEVEL
# ==============================================================

class CacheLevel:

    def __init__(self, name, size_kb, block_size, latency_ns):

        self.name = name
        self.size_kb = size_kb
        self.block_size = block_size
        self.latency_ns = latency_ns

        self.capacity_blocks = max(
            1,
            (size_kb * 1024) // block_size
        )

        self.cache = OrderedDict()

        self.hits = 0
        self.misses = 0

    def access(self, address):

        block = address // self.block_size

        if block in self.cache:

            self.hits += 1

            self.cache.move_to_end(block)

            return True

        self.misses += 1

        return False

    def install(self, address):

        block = address // self.block_size

        if block in self.cache:

            self.cache.move_to_end(block)

            return

        if len(self.cache) >= self.capacity_blocks:

            self.cache.popitem(last=False)

        self.cache[block] = True

    def statistics(self):

        total = self.hits + self.misses

        hit_ratio = (
            self.hits / total
            if total else 0
        )

        miss_ratio = (
            self.misses / total
            if total else 0
        )

        return {
            "Level": self.name,
            "Hits": self.hits,
            "Misses": self.misses,
            "Hit Ratio": hit_ratio,
            "Miss Ratio": miss_ratio
        }


# ==============================================================
# CACHE ANALYZER
# ==============================================================

class CacheAnalyzer:

    def __init__(self, cache_config):

        self.block_size = cache_config["block_size"]

        self.memory_latency = cache_config[
            "memory_latency_ns"
        ]

        self.levels = []

        for level in cache_config["levels"]:

            self.levels.append(
                CacheLevel(
                    level["name"],
                    level["size_kb"],
                    self.block_size,
                    level["latency_ns"]
                )
            )

        self.access_log = []

    def access(self, address):

        accumulated_latency = 0
        result_level = "Main Memory"

        for level in self.levels:

            accumulated_latency += level.latency_ns

            if level.access(address):

                result_level = level.name

                # Install in upper levels
                for upper_level in self.levels:
                    upper_level.install(address)

                    if upper_level.name == level.name:
                        break

                break

        else:

            accumulated_latency += self.memory_latency

            result_level = "Main Memory"

            for level in self.levels:
                level.install(address)

        self.access_log.append({
            "Address": address,
            "Block": address // self.block_size,
            "Result": result_level,
            "Latency (ns)": accumulated_latency
        })

    def analyze(self, instructions):

        for instruction in instructions:

            if (
                instruction.operation.upper()
                in ["LOAD", "STORE"]
                and instruction.address is not None
            ):

                self.access(instruction.address)

        total_accesses = len(self.access_log)

        total_latency = sum(
            item["Latency (ns)"]
            for item in self.access_log
        )

        amat = (
            total_latency / total_accesses
            if total_accesses else 0
        )

        statistics = [
            level.statistics()
            for level in self.levels
        ]

        return {
            "statistics": statistics,
            "access_log": self.access_log,
            "amat": amat
        }


# ==============================================================
# I/O ANALYZER
# ==============================================================
# Abstract base class demonstrates inheritance
# and polymorphism required by the assignment.
# ==============================================================

class IOAnalyzer(ABC):

    def __init__(self, transfer_rate, requests):

        self.transfer_rate = transfer_rate
        self.requests = requests

    @abstractmethod
    def analyze(self, total_mb):

        pass


# ==============================================================
# INTERRUPT-DRIVEN I/O
# ==============================================================

class InterruptDrivenIO(IOAnalyzer):

    def analyze(self, total_mb):

        transfer_time = total_mb / self.transfer_rate

        cpu_service_time = self.requests * 0.002

        cpu_utilization = min(
            100,
            (cpu_service_time / transfer_time) * 100
            if transfer_time else 0
        )

        return {
            "Method": "Interrupt-Driven I/O",
            "Data (MB)": total_mb,
            "Transfer Time (s)": transfer_time,
            "CPU Service Time (s)": cpu_service_time,
            "CPU Utilization (%)": cpu_utilization,
            "CPU Interventions": self.requests
        }


# ==============================================================
# DMA
# ==============================================================

class DMAIO(IOAnalyzer):

    def analyze(self, total_mb):

        transfer_time = total_mb / self.transfer_rate

        setup_time = 0.005

        cpu_service_time = (
            setup_time +
            (self.requests * 0.0002)
        )

        total_time = transfer_time + setup_time

        cpu_utilization = min(
            100,
            (cpu_service_time / total_time) * 100
            if total_time else 0
        )

        return {
            "Method": "DMA",
            "Data (MB)": total_mb,
            "Transfer Time (s)": transfer_time,
            "CPU Service Time (s)": cpu_service_time,
            "CPU Utilization (%)": cpu_utilization,
            "CPU Interventions": 2
        }


# ==============================================================
# PERFORMANCE ANALYZER
# ==============================================================

class PerformanceAnalyzer:

    def analyze(self, pipeline_metrics, cache_result, io_results):

        pipeline_score = pipeline_metrics["cpi"]

        cache_score = cache_result["amat"] / 10

        max_io_utilization = max(
            item["CPU Utilization (%)"]
            for item in io_results
        )

        io_score = max_io_utilization / 10

        scores = {
            "Pipeline": pipeline_score,
            "Cache / Memory": cache_score,
            "I/O": io_score
        }

        bottleneck = max(
            scores,
            key=scores.get
        )

        return scores, bottleneck


# ==============================================================
# LOAD WORKLOAD
# ==============================================================

def load_workload(data):

    instructions = []

    for item in data["instructions"]:

        instructions.append(
            Instruction(
                iid=item["id"],
                operation=item["operation"],
                src=item.get("src", []),
                dest=item.get("dest", ""),
                address=item.get("address"),
                resource=item.get("resource", "ALU")
            )
        )

    return AIJob(
        job_id=data["job_id"],
        num_images=data["num_images"],
        image_size_mb=data["image_size_mb"],
        clock_time_ns=data.get("clock_time_ns", 1),
        instructions=instructions
    )


# ==============================================================
# JSON VALIDATION
# ==============================================================

def validate_workload(data):

    required_fields = [
        "job_id",
        "num_images",
        "image_size_mb",
        "instructions",
        "cache",
        "io"
    ]

    for field in required_fields:

        if field not in data:

            raise ValueError(
                f"Missing required field: {field}"
            )

    if not data["instructions"]:

        raise ValueError(
            "Instruction list cannot be empty."
        )


